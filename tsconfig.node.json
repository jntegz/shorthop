{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/node-dts",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "references": [{ "path": "./tsconfig.shared.json" }],
  "include": ["vite.config.ts", "vitest.config.ts", "scripts", "test/node"],
  // Reads the Worker's API catalog, which belongs to the worker project; tsx runs it untyped.
  "exclude": ["scripts/skill-reference.ts"]
}
