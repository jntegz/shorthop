# The secret the Deploy to Cloudflare button asks for when it deploys Shorthop.
# ADMIN_PASSWORD: the admin password, at least 9 characters. A long random one
# is best: password-only sign-in is all that protects a new install. The other
# secrets (session signing, visitor salt) are generated and kept in D1.
ADMIN_PASSWORD=

# For local development, don't copy this file: run `npm run setup -- local`,
# which writes .dev.vars with random secrets and the localhost bypass. Never
# commit .dev.vars.
