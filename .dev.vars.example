# Copy to .dev.vars for local development, or run `npm run setup -- local`,
# which writes one with random values. Never commit .dev.vars.
API_TOKEN=dev-token-change-me-0123456789abcdef
VISITOR_SALT=dev-salt-0123456789
# Admin password login. Leave ADMIN_PASSWORD_HASH empty to skip the password on
# localhost, or paste the output of: npx tsx scripts/hash-password.ts --generate
ADMIN_PASSWORD_HASH=
SESSION_SECRET=dev-session-secret-change-me-0123456789
# Lets the admin work on localhost without Cloudflare Access. Ignored on any
# other hostname, so it can never open the deployed admin.
DEV_AUTH_BYPASS=1
# Only vars and the required secrets are read from here: optional secrets such
# as CF_ANALYTICS_TOKEN are ignored in local dev (Analytics Engine isn't local).
# Optional: override vars from the config, e.g. to try a second short domain.
# SHORT_DOMAINS=sh.example,alt.example
