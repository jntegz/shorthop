{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/app-dts",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // Resolve the worker through its emitted .d.ts so Workers runtime types
    // never mix with DOM types, in tsc and in the editor.
    "disableSourceOfProjectReferenceRedirect": true
  },
  "references": [{ "path": "./tsconfig.shared.json" }, { "path": "./tsconfig.worker.json" }],
  "include": ["src/client"]
}
