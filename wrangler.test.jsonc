// Config for the test suite only (vitest.config.ts). No account or resource ids:
// Miniflare runs every binding locally.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorthop-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/_admin/*", "!/_admin/assets/*"]
  },
  "kv_namespaces": [{ "binding": "LINKS" }],
  "d1_databases": [{ "binding": "DB", "database_name": "shorthop-test", "migrations_dir": "migrations" }],
  "analytics_engine_datasets": [{ "binding": "CLICKS", "dataset": "shorthop_test_clicks" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [
    { "name": "DIGEST", "destination_address": "owner@example.com", "allowed_sender_addresses": ["digest@sh.example"] }
  ],
  "vars": {
    "ADMIN_AUTH": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAIL": "owner@example.com",
    "CF_ACCOUNT_ID": "",
    "SHORT_DOMAINS": "sh.example",
    "ADMIN_HOST": "",
    "FALLBACK_URL": "https://example.com",
    "KV_CACHE_TTL": "60",
    "AE_DATASET": "shorthop_test_clicks",
    "WORKERS_PLAN": "free",
    // Most API tests change links with the token; auth.test.ts covers the default scope.
    "API_TOKEN_SCOPE": "full",
    "DIGEST_PROVIDER": "cloudflare",
    "DIGEST_FROM": "digest@sh.example",
    "DIGEST_TO": "owner@example.com",
    "DEV_AUTH_BYPASS": ""
  }
}
