// Generated by `npm run setup` (scripts/setup/template.ts). Re-run the setup to
// change it, or edit it by hand: the setup reads it back. Secrets are never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorthop",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // One custom domain per short domain, plus ADMIN_HOST. Each must be in a zone
  // in this Cloudflare account, with no DNS record of its own on the hostname.
  "routes": [
    { "pattern": "sh.example", "custom_domain": true }
  ],

  "assets": {
    "binding": "ASSETS",
    // No SPA fallback and no HTML auto-handling: every unknown path must reach
    // the Worker so it can be treated as a slug. Only exact files bypass it.
    "html_handling": "none",
    "not_found_handling": "none",
    // The admin shell goes through the Worker (auth check + CSP); its hashed
    // JS/CSS bundles are served straight from the asset store.
    "run_worker_first": ["/_admin/*", "!/_admin/assets/*"]
  },

  "kv_namespaces": [{ "binding": "LINKS" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shorthop",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "CLICKS", "dataset": "shorthop_clicks" },
    // Website analytics events from /_t/script.js (src/worker/web/collect.ts).
    { "binding": "WEB", "dataset": "shorthop_web" }
  ],
  "ratelimits": [
    // Failed API-token attempts per client IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Admin password attempts per client network (a burst brake; the lockout
    // that counts is kept in D1).
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Password attempts on a protected short link, per client network and link.
    { "name": "LINK_PASSWORD_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // Shared statistics pages and payment webhooks, per client network.
    { "name": "PUBLIC_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    // Website analytics events per client network, all sites together (a page sends a
    // few per view; this only stops floods of made-up traffic).
    { "name": "COLLECT_LIMITER", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } }
  ],

  // Exact click limits: one counter per capped link, used only by links with a
  // limit (src/worker/click-cap.ts). SQLite-backed, so it works on the Free plan.
  "durable_objects": {
    "bindings": [{ "name": "CLICK_CAPS", "class_name": "ClickCap" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClickCap"] }],

  "send_email": [
    {
      "name": "DIGEST",
      // Cloudflare Email Service can only ever send the digest to this address.
      "destination_address": "owner@example.com",
      "allowed_sender_addresses": ["digest@sh.example"]
    }
    // Optional: lets the "cloudflare" provider email invite and reset links to
    // the people in Settings → People. Needs Email Sending on Workers Paid
    // (docs/SETUP.md#people). Uncomment and use your sender address:
    // , { "name": "PEOPLE_MAIL", "allowed_sender_addresses": ["you@your-domain"] }
  ],

  "triggers": {
    // Hourly at :15 (daily rollups at 01:15 UTC, website alerts the other hours),
    // weekly digest Mondays 07:00 UTC, destination checks every 30 minutes; the
    // 02:00 and 03:00 UTC ones do the cleanup and the revenue work instead
    // (src/shared/schedule.ts).
    "crons": ["15 * * * *", "0 7 * * 1", "*/30 * * * *"]
  },

  "vars": {
    // "access+password" (or empty): Cloudflare Access in front of the admin
    // password. "password": the password alone. Anything else locks the admin.
    "ADMIN_AUTH": "access+password",
    // Cloudflare Access team domain ("yourteam.cloudflareaccess.com") and the
    // application's AUD tag. With Access on, the admin fails closed while empty.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // The only Access identity allowed into the admin, comma-separated for more.
    "ADMIN_EMAIL": "owner@example.com",
    // Needed to query Analytics Engine over its SQL API (with CF_ANALYTICS_TOKEN).
    "CF_ACCOUNT_ID": "",
    // Short domains, comma-separated, primary first. New links default to the
    // primary; it also hosts the admin and the API unless ADMIN_HOST is set.
    "SHORT_DOMAINS": "sh.example",
    // Optional separate host for the admin and the API (no short links there).
    "ADMIN_HOST": "",
    // Where "/" goes, and clicks when the link store can't be read. Referrals from its host count as "site".
    "FALLBACK_URL": "https://example.com",
    "KV_CACHE_TTL": "60",
    // The Analytics Engine dataset above (letters, digits and _ only).
    "AE_DATASET": "shorthop_clicks",
    "AE_WEB_DATASET": "shorthop_web",
    // "free" or "paid". Sizes bulk work (republish pages, import batches, checks
    // per run) to the plan's subrequest limit, and System status checks the
    // password hash cost against it. Say "free" unless you pay for Workers.
    "WORKERS_PLAN": "free",
    // What the API token may do: "create" reads, creates links and imports new
    // ones; "full" also changes and deletes links and settings.
    "API_TOKEN_SCOPE": "create",
    // Digest and alert delivery: cloudflare, resend, emailit, postmark, sendgrid, mailgun, custom, webhook, off.
    // Settings → Weekly digest → Set up email overrides the provider and sender
    // without a deploy. API keys and URLs are secrets (docs/SETUP.md#email).
    "DIGEST_PROVIDER": "cloudflare",
    "DIGEST_FROM": "digest@sh.example",
    // The only recipient.
    "DIGEST_TO": "owner@example.com",
    // Set to "1" only in .dev.vars. Honored solely on localhost/127.0.0.1.
    "DEV_AUTH_BYPASS": "",
    // With DEV_AUTH_BYPASS only: act as this person (a row in Settings → People)
    // to try their view locally. Empty means an owner.
    "DEV_AUTH_EMAIL": ""
  },

  "secrets": {
    // Set by `npm run setup`. VISITOR_SALT: mixed into the visitor hash.
    // ADMIN_PASSWORD_HASH: the owners' password, a PBKDF2 hash. SESSION_SECRET:
    // signs admin sessions (rotate it to log out everywhere).
    // Optional, not listed: CF_ANALYTICS_TOKEN, the digest provider's keys,
    // API_TOKEN (a Bearer token for /api from before personal API keys) and
    // TURNSTILE_SECRET (the optional bot check, Settings → Access & security).
    // wrangler dev ignores them in .dev.vars.
    "required": ["VISITOR_SALT", "ADMIN_PASSWORD_HASH", "SESSION_SECRET"]
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
