# Admin static assets bypass the Worker (run_worker_first), so the security headers are set here too.
# Not HSTS: the admin page that loads them always comes through the Worker, which sends it
# as the HSTS setting says. A fixed value here would undo "subdomains" on every asset load.
/_admin/assets/*
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff

# Vite's content-hashed bundles can be reused without another network request.
/_admin/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/_admin/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
