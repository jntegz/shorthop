{
  "name": "Shorthop",
  "short_name": "Shorthop",
  "description": "Your short links, statistics and websites.",
  "start_url": "/_admin/",
  "scope": "/_admin/",
  "display": "standalone",
  "background_color": "#f8f9f7",
  "theme_color": "#6554c0",
  "icons": [
    { "src": "/_admin/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/_admin/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/_admin/assets/brand.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/_admin/links",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
